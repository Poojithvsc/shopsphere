# Copy to terraform.tfvars (gitignored) and fill in before `terraform apply`.
# Find your public /32 with: curl -s https://checkip.amazonaws.com

my_ip_cidr  = "203.0.113.4/32"            # only used for SSH (22); RDS is now private
db_password = "set-a-strong-password-in-your-lab-session"
jwt_secret  = "generate-with: openssl rand -base64 48"

# Phase 20: set true to also start Caddy (HTTPS on :443, self-signed). Leave false for Phase 12 only.
# enable_https = true

# Optional EC2 key pair (for SSH debugging). Leave unset to launch without SSH.
# key_name = "my-lab-keypair"

# Override only if your Whizlabs sandbox is not in us-east-1:
# aws_region = "us-west-2"

# If the app OOMs on t3.micro (app + Kafka are two JVMs in 1 GiB), bump to t3.small:
# instance_class = "t3.small"
