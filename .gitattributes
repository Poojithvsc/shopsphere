# Normalize line endings on commit; check out native on each OS
* text=auto eol=lf

# Explicit text files
*.java       text eol=lf
*.kt         text eol=lf
*.xml        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.properties text eol=lf
*.sql        text eol=lf
*.sh         text eol=lf
Dockerfile   text eol=lf

# Windows-only scripts keep CRLF
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# Binary
*.jar        binary
*.war        binary
*.ear        binary
*.class      binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.pdf        binary
